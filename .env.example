SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Solo para el build separado del panel (usar los orígenes HTTPS al publicar):
# PANEL_URL=http://localhost:8081
# STOREFRONT_URL=http://localhost:8080
# Requerido en la rama de producción de Cloudflare Pages:
# SITE_URL=https://your-custom-domain.example
# Opcional; main es el valor predeterminado:
# PRODUCTION_BRANCH=main
# Forzar noindex manualmente en cualquier entorno:
# NOINDEX=1
