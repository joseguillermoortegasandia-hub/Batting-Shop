{
  "name": "batting-shop-catalog",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "version": "4.0.0-stage3",
  "scripts": {
    "build": "node build.mjs",
    "build:local": "node --env-file=.env.local build.mjs",
    "preview": "python -m http.server 8080 --bind 127.0.0.1 --directory dist",
    "verify": "python private/tests/verify.py",
    "test:browser": "python private/tests/browser_smoke.py",
    "preinstall": "node private/scripts/check-package-manager.mjs",
    "build:panel": "node build-panel.mjs",
    "build:panel:local": "node --env-file=.env.local build-panel.mjs",
    "preview:panel": "python -m http.server 8081 --bind 127.0.0.1 --directory dist-panel"
  },
  "description": "Batting Shop V4 Stage 3 — alias de slugs, CSV dinámico attr: y cierre acumulativo de las tres etapas.",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jose": "6.2.15"
  }
}
