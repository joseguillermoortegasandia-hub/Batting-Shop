{
  "name": "batting-shop-catalog",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "version": "4.0.0-stage3",
  "scripts": {
    "build": "node build.mjs",
    "build:local": "node --env-file=.env.local build.mjs",
    "preview": "python private/scripts/preview-server.py --port 8080 --directory dist",
    "verify": "python private/tests/verify.py",
    "test:browser": "python private/tests/browser_smoke.py",
    "test:panel": "python private/tests/admin_workflow_test.py",
    "preinstall": "node private/scripts/check-package-manager.mjs",
    "build:panel": "node build-panel.mjs",
    "build:panel:local": "node --env-file=.env.local build-panel.mjs",
    "preview:panel": "python private/scripts/preview-server.py --port 8081 --directory dist-panel",
    "test:pages": "python private/tests/pages_runtime_test.py",
    "configure:pages": "node private/scripts/configure-pages.mjs",
    "check:live": "node --env-file=.env.local private/scripts/check-live.mjs",
    "preview:all": "pwsh -NoProfile -File private/scripts/start-previews.ps1"
  },
  "description": "Batting Shop V4 Stage 3 — alias de slugs, CSV dinámico attr: y cierre acumulativo de las tres etapas.",
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jose": "6.2.15",
    "wrangler": "4.157.0"
  }
}
