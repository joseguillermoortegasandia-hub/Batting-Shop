/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: __SUPABASE_ORIGIN__; connect-src 'self' __SUPABASE_ORIGIN__; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/catalogo.html
  Cache-Control: no-store

/catalogo
  Cache-Control: no-store

/favoritos.html
  Cache-Control: no-store

/favoritos
  Cache-Control: no-store

/producto/*
  Cache-Control: no-store

/tallas.html
  Cache-Control: no-store

/tallas
  Cache-Control: no-store

/404.html
  Cache-Control: no-store

/404
  Cache-Control: no-store

/manifest.webmanifest
  Cache-Control: public, max-age=3600, must-revalidate

/assets/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/icons/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate
